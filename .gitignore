# ============================================
# .gitignore - EstateAI Rwanda
# ============================================
# Keeps secrets, dependencies, and build artifacts out of git.

# ===== Python / Flask =====
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/

# ===== SQLite local DB (don't commit local data) =====
backend/estate.db
backend/estate.db-journal
*.sqlite
*.sqlite3

# ===== Trained models (large files - stored separately) =====
# IMPORTANT: We WANT to commit these so Render can use them.
# Comment OUT the lines below if you want models in git.
# backend/ml/*.pkl
# backend/ml/model.pkl

# ===== Datasets (kept in repo - small, useful) =====
# backend/data/*.csv

# ===== Node / React =====
frontend/node_modules/
mobile/node_modules/
**/node_modules/
**/dist/
**/build/
**/.vite/

# ===== Environment files (NEVER commit secrets) =====
.env
.env.local
.env.*.local
backend/.env

# ===== Expo / React Native =====
mobile/.expo/
mobile/.expo-shared/
mobile/dist/
mobile/web-build/
mobile/*.jks
mobile/*.p8
mobile/*.p12
mobile/*.key
mobile/*.mobileprovision
mobile/*.orig.*

# ===== EAS =====
eas-cli-debug.log

# ===== OS / Editors =====
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ===== Logs =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pip-log.txt
pip-delete-this-directory.txt

# ===== Output / temp =====
outputs/
tmp/
temp/
